{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "trace-event",
  "type": "object",
  "required": ["ts", "run_id", "unit", "event", "status", "detail"],
  "properties": {
    "ts": {"type": "string", "format": "date-time"},
    "run_id": {"type": "string"},
    "unit": {"type": "string"},
    "event": {"enum": ["start", "tool_call", "gate_result", "retry", "escalate", "done", "failure"]},
    "tool": {"type": "string"},
    "status": {"enum": ["pass", "fail", "skip", "ok", "error"]},
    "detail": {"type": "string", "maxLength": 500}
  },
  "additionalProperties": false
}
